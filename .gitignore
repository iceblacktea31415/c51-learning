# ============================================================
#  51 单片机学习工程集 —— 全局忽略规则
#  原则：只把「源码 + 工程配置」放进仓库，编译产物一律忽略
# ============================================================

# ---------------- Keil uVision (C51) 编译产物 ----------------
# 每个工程的输出目录
**/Objects/
**/Listings/

# uVision 的个人界面状态（窗口位置、断点等，每人一份，不该共享）
*.uvgui.*
*.uvgui

# 编译中间文件
*.build_log.htm
*.lnp
*.m51
*.obj
*.lst
*.hex
*.omf
*.abs
*.__i

# uVision 自动备份
*.bak
*.uvproj.bak

# ---------------- EIDE（VSCode 插件）编译产物 ----------------
**/build/
**/bin/
**/obj/
**/out/

# EIDE 本地缓存 / 用户上下文
.eide/log/
.eide.usr.ctx.json
.vscode/launch.json

# EIDE 工程模板文件
*.ept
*.eide-template

# ---------------- 编辑器 / 操作系统垃圾 ----------------
.vs/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store
